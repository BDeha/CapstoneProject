{
  "name": "privilege-walk-app",
  "version": "1.0.0",
  "description": "Classroom Privilege Walk Polling Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.bdeha.privilegewalk",
    "productName": "Privilege Walk Polling App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "privilege-backend/**/*",
      "privilege-frontend/build/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^8.0.0"
  }
}